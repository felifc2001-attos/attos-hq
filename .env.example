# Copiá este archivo como .env.local y completá los dos valores (Supabase > Project Settings > API).
# En Vercel se cargan en Settings > Environment Variables, con estos mismos nombres.
#
# Las dos son públicas por diseño (van al navegador): la seguridad la da RLS en la base, no ocultar estos valores.
# NUNCA pongas acá la clave "service_role" / "secret": esa da acceso total y jamás debe salir de un servidor de confianza.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
